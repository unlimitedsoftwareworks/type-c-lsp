type Array<T> = class {
    let data: T[]
    let capacity: u64
    let length: u64

    fn init(mut inital: T[]) {
        this.{
            data: inital,
            capacity: inital.length,
            length: inital.length,
        }
    }

    fn map<U>(f: fn(T) -> U) -> Array<U>{
        let arr: U[] = []
        arr.resize(this.length)

        foreach i, v in data {
            arr[i] = f(v)
        }

        return new Array<U>(arr)
    }
}

fn vec<T>(mut initial: T[]) {
    return new Array<T>(initial)
}

local namespace MathUtils = {
    fn abs(x: i32) -> i32 {
        if x < 0 {
            return -x
        }
        return x
    }
}

fn main(args: i32[]) {
    let values = vec(args).map(fn(x: i32) = MathUtils.abs(x))
}


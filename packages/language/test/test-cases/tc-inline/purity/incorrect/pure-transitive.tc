// Test: transitive mutation — method calls this.mutatingMethod()

type PureGetter = interface {
    pure fn safeGet() -> i32
}

/// @Error(TCE007): method 'safeGet' is declared as 'pure' in the interface
type TransitiveMutator = class PureGetter {
    let value: i32

    fn init(v: i32) {
        this.value = v
    }

    fn applyMutation() -> void {
        this.value = this.value + 1i32
    }

    // safeGet calls this.mutate() which mutates this — so safeGet is not pure
    fn safeGet() -> i32 {
        this.applyMutation()
        return this.value
    }
}

/// @Error(TCE007): method 'safeGet' is declared as 'pure' in the interface, but the implementing method mutates 'this'. Pure methods must not modify any fields of 'this'.
let x: PureGetter = new TransitiveMutator(10i32)

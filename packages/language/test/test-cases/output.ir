    %pivot_1: i32 = mov %t0
    %i_1: u64 = mov low
    %t1: u64 = const_int 1
    for_init %j_2 low high %t1 @fori_exit_0
fori_body_1:
    %t2: i32 = array_get arr %j_2
    %t4: i32 = mov %t2
    %t5: i32 = mov %pivot_1
    %t3: bool = cmp_lt.i32 %t4 %t5
    br %t3 @then_3 @else_4
then_3:
    call swap(arr: ptr.array, %i_1: u64, %j_2: u64)
    %t7: u64 = const_int 1
    %t9: u64 = mov %i_1
    %t10: u64 = mov %t7
    %t8: u64 = add.u64 %t9 %t10
    %i_1: u64 = mov %t8
    jmp @endif_5
else_4:
    jmp @endif_5
endif_5:
fori_update_2:
    for_loop %j_2 @fori_body_1
fori_exit_0:
    call swap(arr: ptr.array, %i_1: u64, high: u64)
    ret %i_1: u64
}

fn quickSort(arr: ptr.array, low: u64, high: u64) -> void {
    %t1: u64 = mov low
    %t2: u64 = mov high
    %t0: bool = cmp_lt.u64 %t1 %t2
    br %t0 @then_0 @else_1
then_0:
    %t3: u64 = call partition(arr: ptr.array, low: u64, high: u64)
    %pi_2: u64 = mov %t3
    %t4: u64 = const_int 0
    %t6: u64 = mov %pi_2
    %t7: u64 = mov %t4
    %t5: bool = cmp_gt.u64 %t6 %t7
    br %t5 @then_3 @else_4
then_3:
    %t8: u64 = const_int 1
    %t10: u64 = mov %pi_2
    %t11: u64 = mov %t8
    %t9: u64 = sub.u64 %t10 %t11
    call quickSort(arr: ptr.array, low: u64, %t9: u64)
    jmp @endif_5
else_4:
    jmp @endif_5
endif_5:
    %t14: u64 = mov %pi_2
    %t15: u64 = mov high
    %t13: bool = cmp_lt.u64 %t14 %t15
    br %t13 @then_6 @else_7
then_6:
    %t16: u64 = const_int 1
    %t18: u64 = mov %pi_2
    %t19: u64 = mov %t16
    %t17: u64 = add.u64 %t18 %t19
    call quickSort(arr: ptr.array, %t17: u64, high: u64)
    jmp @endif_8
else_7:
    jmp @endif_8
endif_8:
    jmp @endif_2
else_1:
    jmp @endif_2
endif_2:
    ret
}

fn serializeArray(arr: ptr.array) {

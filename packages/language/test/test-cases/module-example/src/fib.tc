/**
 * Fibonacci sequence
 * @param n - the nth number in the sequence
 * @return the nth number in the sequence
 */
fn fib(n: u32) {
    if n <= 1 {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

type Color = enum as u8 {
    Red = 0,
    Green = 1,
    Blue = 2,
}

type Tree = variant {
    Leaf(value: u32),
    Branch(left: Tree, right: Tree),
}

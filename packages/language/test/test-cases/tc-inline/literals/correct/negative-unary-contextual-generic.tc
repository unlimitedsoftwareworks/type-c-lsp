fn assert_eq<T>(actual: T, expected: T) -> bool {
    return true
}

fn test_negative_unary_contextual_generic() {
    let v_u8: u8 = 1
    let v_i8: i8 = 5
    let v_i16: i16 = 6

    // Regression: unary negative constants should adopt contextual generic type.
    assert_eq<i16>(v_u8 - v_i8 as i16, -4)
    assert_eq<i16>(v_u8 - v_i16, -5)
}

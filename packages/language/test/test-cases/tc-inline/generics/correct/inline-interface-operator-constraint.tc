type Addable = class {
    let value: u32
    fn init(value: u32 = 0u32) {
    }

    fn +(x: Addable) = new Addable(this.value + x.value)
}

fn main() {

    fn addObj<T: interface { fn +(T) -> T} >(x: T, y: T) -> T {
        return x + y
    }

    // Fails as expected
    // let c2 = addObj(1, 1)

    /**
     * Type 'Addable' does not satisfy constraint 'interface {
	 * fn +(T: <error: Node is undefined>) -> T
     * }'.type-c(TCE120)
     */
    let v = new Addable(1)
    let c3 = addObj(v, v)
}
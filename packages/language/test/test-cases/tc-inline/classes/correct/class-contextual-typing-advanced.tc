// Test: Advanced contextual array typing scenarios with classes.

type Animal = interface {
    fn speak() -> string
}

type Dog = class {
    fn speak() -> string = "woof"
    fn fetch() -> void {}
}

type Cat = class {
    fn speak() -> string = "meow"
    fn purr() -> void {}
}

// --- Same class in array (nominal, trivial LUB) ---

fn testSameClassArray() {
    let dogs: Dog[] = [new Dog(), new Dog()]
}

// --- Function parameter context ---

fn processAnimals(animals: Animal[]) -> void {}

fn testFunctionParameterContext() {
    // Passing inline array literal to function expecting Animal[]
    processAnimals([new Dog(), new Cat()])
}

// --- Assignment with interface array ---

fn testInterfaceArrayAssignment() {
    let a: Animal = new Dog()
    let b: Animal = new Cat()
    let animals: Animal[] = [a, b]
}

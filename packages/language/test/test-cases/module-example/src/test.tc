from std.io import println

type Animal = interface {
    fn quack() -> void
}

type Dog = class Animal {
    fn quack() {
        println("Woof")
    }
}

type Cat = class Animal {
    fn quack() {
        println("Meoow")
    }
}

fn main() {

    let dog: Animal = new Dog()
    let cat: Animal = new Dog()

    dog.quack()
    println("done")

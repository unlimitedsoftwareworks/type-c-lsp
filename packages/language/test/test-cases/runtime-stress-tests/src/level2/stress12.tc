from std.unit.test import TestUnit, UnitSet

fn sumThree<T || (T + T) -> T>(a: T, b: T, c: T) -> T {
    return a + b + c
}

fn clampMin<T || (T < T) -> bool>(value: T, minValue: T) -> T {
    if value < minValue {
        return minValue
    }
    return value
}

type Accumulator<T || (T + T) -> T> = class {
    let value: T

    fn init(mut value: T) {
        this.value = value
    }

    fn add(v: T) {
        this.value = this.value + v
    }

    fn get() -> T {
        return this.value
    }
}

fn test_case_1(mut rn: TestUnit) {
    rn.assert_eq(sumThree<u32>(1u32, 2u32, 3u32), 6u32)
    rn.assert_f32_eq_pre(sumThree<f32>(1.0f, 2.0f, 3.5f), 6.5f, 0.0001f)

    rn.assert_eq(clampMin<u32>(3u32, 8u32), 8u32)
    rn.assert_eq(clampMin<u32>(10u32, 8u32), 10u32)

    let acc = new Accumulator<u32>(5u32)
    acc.add(10u32)
    acc.add(20u32)
    rn.assert_eq(acc.get(), 35u32)
}

fn stress12() -> u32 {
    let t1 = new TestUnit("generic constraints", "Type/operator constrained generics", test_case_1)
    let set = new UnitSet("Stress 12", "Constrained generic stress", [t1])
    return set.run()
}

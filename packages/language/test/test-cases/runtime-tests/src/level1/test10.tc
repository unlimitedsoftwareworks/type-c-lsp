from std.unit.test import TestUnit, UnitSet

type Data<T> = class {
    let data: T[]

    fn init(){
        this.data = []
        this.data.resize(10)
    }

    fn [](index: u64) -> T {
        return this.data[index]
    }

    fn []= (index: u64, index2: T, value: T){
        this.data[index] = value
        return value
    }

    fn () (x: u32) -> T {
        return this.data[x]
    }

    fn + (y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }


    fn -(y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }


    fn *(y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }


    fn /(y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn %(y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn > (y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn < (y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn >= (y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn <= (y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn << (y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn >> (y: Data<T>) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn & (y: string) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn | (y: u32) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn ^ (y: u32) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn && (y: string) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn || (y: u32) -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    
    fn ~ () -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn - () -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn ! () -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn ++ () -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }

    fn -- () -> Data<T> {
        let z = new Data<T>()
        z.data = this.data
        return z
    }
}

fn test_case_1(mut rn: TestUnit) {
    let d = new Data<string>()
    let zzz = d[1, "hehe"] = "hi"
    let value1 = d[1]

    rn.assert_eq<string>(value1, "hi")

    let value2 = d(1)
    rn.assert_eq<string>(value2, "hi")
    let D = !d
    let value3 = D[1]
    rn.assert_eq<string>(value3, "hi")

    let value4 = D(1)
    rn.assert_eq<string>(value4, "hi")
}


type Tree = variant {
    BinaryNode(lhs: Tree, rhs: Tree, op: string),
    Unary(uhs: Tree, op: string),
    Number(n: i32)
}

fn sum(t: Tree)  -> i32 = match t {
    Tree.BinaryNode(lhs, rhs, op) => match op {
        "+" => sum(lhs) + sum(rhs),
        "-" => sum(lhs) - sum(rhs),
        "*" => sum(lhs) * sum(rhs),
        "/" => sum(lhs) / sum(rhs),
        _ => 0 as i32
    },
    Tree.Unary(uhs, op) => match op {
        "-" => -sum(uhs),
        _ => 0 as i32
    },
    Tree.Number(n) => n,
    _ => 0 as i32
}

fn test_case_2(mut rn: TestUnit) {

    let tree: Tree= Tree.BinaryNode(Tree.Number(4), Tree.Unary(Tree.Number(2), "-"), "*")
    let z = sum(tree)
    rn.assert_eq<i32>(z, -8)

    // more complex tree, with 8 nodes
    let tree2: Tree= Tree.BinaryNode(Tree.BinaryNode(Tree.Number(1), Tree.Number(2), "+"), Tree.BinaryNode(Tree.Number(3), Tree.Number(4), "-"), "*")
    let z2 = sum(tree2)
    rn.assert_eq<i32>(z2, -3)


    /*
                                +
                               / \
                              -   /
                             /   / \
                            *   *   -
                           / \ / \  / \
                         100  /  5 +  -
                             / \   / \ / \
                            50  2  3 2 8  4
    */
    let deepTree: Tree = 
    Tree.BinaryNode(
        Tree.BinaryNode(
            Tree.BinaryNode(
                Tree.Number(100), 
                Tree.BinaryNode(
                    Tree.Number(50), 
                    Tree.Number(2), 
                    "/"
                ), 
                "*"
            ), 
            Tree.Number(10), 
            "-"
        ), 
        Tree.BinaryNode(
            Tree.BinaryNode(
                Tree.Number(5), 
                Tree.BinaryNode(
                    Tree.Number(3), 
                    Tree.Number(2), 
                    "+"
                ), 
                "*"
            ), 
            Tree.BinaryNode(
                Tree.Number(8), 
                Tree.Number(4), 
                "-"
            ), 
            "/"
        ), 
        "+"
    )

    let z3 = sum(deepTree)
    rn.assert_eq<i32>(z3, 2496)
}


type User1 = interface {
    fn name() -> string
}

type User2 = interface {
    fn name2() -> string
}

type User3 = interface {
    fn name3() -> string
}

type User4 = interface {
    fn name4() -> string
}

type ClassUser3 = class {
    fn init(){}
    fn name3() -> string = "User3"
    fn name4() -> string = "User4"
    fn age() -> u32 = 30
}

type Ageable<T> = interface {
    fn age() -> T
}

fn test_case_3(mut rn: TestUnit) {
    let x = new ClassUser3()

    let y = match x {
        User1=> "User1",
        User2 => "User2",
        User3 => "User3",
        _ => "Unknown"
    }

    rn.assert_eq<string>(y, "User3")

    match x {
        User1 {
            rn.assert_unreachable()
        }
        User2 {
            rn.assert_unreachable()
        }
        User3 & User4 {
            rn.assert_reachable()
        }
        user3 {
            // correct but needs to match User3 & User4
            rn.assert_unreachable()
        }
        _ {
            rn.assert_unreachable()
        }
    }


    match x {
        Ageable<u32> & User3 & User4 {
            rn.assert_reachable()
        }
        _ {
            rn.assert_unreachable()
        }
    }


/*
    fn addObj<T: interface { fn + (T) -> T} >(x: T, y: T) -> T {
        return x + y
    }

    let c2 = addObj(1, 1)


    fn addVars<U, V, W || (U + V) -> W>(a: U, b: V) -> W {
        return a + b
    }

    let java = addVars<string, i32, i32>("hi", 1)
*/


    fn add<U || (U+U) -> U>(x: U, y: U) -> U {
        return x + y
    }

    let c = add(1, 2)
    rn.assert_eq(c, 3)
    let d = add("hi", " there")
    rn.assert_eq(d, "hi there")
}

type ServerResponse = variant {
    Ok(),
    Error(code: u32)
}

type GenericServerResponse<T> = variant {
    Ok(),
    Error(code: T)
}

fn test_case_4(mut rn: TestUnit) {
    let resp1 = ServerResponse.Error(404)
    let resp2 = GenericServerResponse.Error<string>("404 Not found")

    resp1.code = 200
    resp2.code = "Ok"

    rn.assert_eq(resp1.code, 200)
    rn.assert_eq(resp2.code, "Ok")
}

fn test10() -> u32 {
    let test_1 = new TestUnit("test 1", "Test Set/Get", test_case_1)
    let test_2 = new TestUnit("test 2", "Test Variant", test_case_2)
    let test_3 = new TestUnit("test 3", "Test Interface/class/join", test_case_3)
    let test_4 = new TestUnit("test 4", "Test variant field assignment", test_case_4)

    let set = new UnitSet("STD Test 10", "Tests pattern matching expression and statements", [
        test_1, 
        test_2, 
        test_3,
        test_4
    ])
    
    return set.run()
}
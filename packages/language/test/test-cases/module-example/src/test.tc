type Animal = interface {
    fn makeNoise() -> void
}

type Cat = class {
    fn makeNoise() {

    }
}

type Dog = class {
    fn makeNoise() {

    }
}

fn main() {
    let a1: Animal = new Dog() // Ok
    let a2: Animal = new Cat() // Ok

    let a3: Cat = new Dog() // Error: Variable 'a3' type mismatch: Class types differ

    let animals1 = [
        new Dog(), new Cat() // LUB discovers common method makeNoise() -> interface { fn makeNoise() -> void }
    ]

    let animals2: Animal[] = [
        new Dog(), new Cat() // Contextual typing checks assignability to Animal
    ]
}

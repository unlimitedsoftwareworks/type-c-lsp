from std.io import println

type Addable<U || (U+U) -> U> = class {
    let value: U
    fn init(value: U) {
        this.value = value
    }

    fn +(x: Addable) -> Addable = new Addable<U>(this.value + x.value)
}

fn main() {

    fn addObj<T: interface { fn +(T) -> T} >(x: T, y: T) -> T {
        return x+y
    }

    // Fails as expected
    // let c2 = addObj(1, 1)

    /**
     * Type 'Addable' does not satisfy constraint 'interface {
	 * fn +(T: <error: Node is undefined>) -> T
     * }'.type-c(TCE120)
     */
    let v = new Addable(1)
    let c3 = addObj(new Addable(1), new Addable(200))

    println("Execution finished, sum = " + c3.value)
}
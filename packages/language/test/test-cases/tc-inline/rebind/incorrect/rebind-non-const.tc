// Test: Rebind ':=' on non-const variables should fail

type Point = struct {
    x: u32,
    y: u32
}

fn testNonConstPrimitive() {
    let x: u32 = 10u32
    /// @Error(TCE197): Rebind ':=' can only be used on const variables
    x := 20u32
}

fn testNonConstStruct() {
    let p = {x: 1u32, y: 2u32}
    /// @Error(TCE197): Rebind ':=' can only be used on const variables
    p := {x: 3u32, y: 4u32}
}

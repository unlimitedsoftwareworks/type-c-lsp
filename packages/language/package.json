{
    "name": "type-c-language",
    "description": "The language specific package",
    "version": "0.0.1",
    "type": "module",
    "engines": {
        "node": ">=20.10.0",
        "npm": ">=10.2.3"
    },
    "files": [
        "out",
        "src"
    ],
    "main": "./out/index.js",
    "module": "./out/index.js",
    "exports": {
        ".": {
            "types": "./out/index.d.ts",
            "default": "./out/index.js"
        },
        "./ast": {
            "types": "./out/ast.d.ts",
            "default": "./out/ast.js"
        },
        "./types": {
            "types": "./out/types.d.ts",
            "default": "./out/types.js"
        },
        "./services": {
            "types": "./out/services.d.ts",
            "default": "./out/services.js"
        },
        "./profiling": {
            "types": "./out/profiling.d.ts",
            "default": "./out/profiling.js"
        }
    },
    "typesVersions": {
        "*": {
            ".": [
                "out/index"
            ],
            "ast": [
                "out/ast"
            ],
            "types": [
                "out/types"
            ],
            "services": [
                "out/services"
            ],
            "profiling": [
                "out/profiling"
            ]
        }
    },
    "scripts": {
        "clean": "shx rm -fr *.tsbuildinfo out",
        "build": "echo 'No build step'",
        "build:clean": "npm run clean && npm run build",
        "langium:generate": "langium generate",
        "langium:watch": "langium generate --watch",
        "test": "vitest run"
    },
    "dependencies": {
        "langium": "~4.1.0"
    },
    "devDependencies": {
        "langium-cli": "~4.1.0",
        "vitest": "~3.1.3"
    },
    "volta": {
        "node": "20.19.2",
        "npm": "10.8.2"
    }
}

from std.io import println

type AbstractStorage = interface {
    fn openFile(uri: string, mode: string)
}

type FileStorage = class {
    fn openFile(uri: string, mode: string = "read") {
        println("protocol: file://")
        println(uri)
        println(mode)
    }
}

type S3Storage = class {
    fn openFile(uri: string, mode: string = "write") {
        println("protocol: s3://")
        println(uri)
        println(mode)
    }
}

fn main() {
    let const fs1: AbstractStorage = new FileStorage()
    fs1.openFile("file1.tc", "write")
    let const fs2: AbstractStorage = new S3Storage()
    fs2.openFile("file2.tc", "write")
}


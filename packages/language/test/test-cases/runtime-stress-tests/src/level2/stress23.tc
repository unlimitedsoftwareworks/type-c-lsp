from std.unit.test import TestUnit, UnitSet

type Matrix2 = struct {
    a11: f32,
    a12: f32,
    a21: f32,
    a22: f32
}

prototype Matrix2 {
    fn + (other: Matrix2) -> Matrix2 {
        return {
            a11: this.a11 + other.a11,
            a12: this.a12 + other.a12,
            a21: this.a21 + other.a21,
            a22: this.a22 + other.a22
        }
    }

    fn * (other: Matrix2) -> Matrix2 {
        return {
            a11: this.a11 * other.a11 + this.a12 * other.a21,
            a12: this.a11 * other.a12 + this.a12 * other.a22,
            a21: this.a21 * other.a11 + this.a22 * other.a21,
            a22: this.a21 * other.a12 + this.a22 * other.a22
        }
    }

    fn trace() -> f32 {
        return this.a11 + this.a22
    }

    fn det() -> f32 {
        return this.a11 * this.a22 - this.a12 * this.a21
    }
}

fn test_case_1(mut rn: TestUnit) {
    let m1: Matrix2 = {a11: 1.0f, a12: 2.0f, a21: 3.0f, a22: 4.0f}
    let m2: Matrix2 = {a11: 2.0f, a12: 0.0f, a21: 1.0f, a22: 2.0f}

    let sum = m1 + m2
    rn.assert_f32_eq_pre(sum.a11, 3.0f, 0.0001f)
    rn.assert_f32_eq_pre(sum.a22, 6.0f, 0.0001f)

    let prod = m1 * m2
    rn.assert_f32_eq_pre(prod.a11, 4.0f, 0.0001f)
    rn.assert_f32_eq_pre(prod.a12, 4.0f, 0.0001f)
    rn.assert_f32_eq_pre(prod.a21, 10.0f, 0.0001f)
    rn.assert_f32_eq_pre(prod.a22, 8.0f, 0.0001f)

    rn.assert_f32_eq_pre(m1.trace(), 5.0f, 0.0001f)
    rn.assert_f32_eq_pre(m1.det(), -2.0f, 0.0001f)
}

fn stress23() -> u32 {
    let t1 = new TestUnit("matrix prototype", "Prototype arithmetic and linear algebra primitives", test_case_1)
    let set = new UnitSet("Stress 23", "Matrix prototype stress", [t1])
    return set.run()
}
